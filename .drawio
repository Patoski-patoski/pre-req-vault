    <diagram id="solana-vault-architecture" name="Vault Program Architecture">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" background="#0f172a" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <!-- Title Banner -->
                <mxCell id="title" value="Solana Anchor Vault Program Architecture (with Registration CPI)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#f8fafc;" vertex="1" parent="1">
                    <mxGeometry x="250" y="20" width="800" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="subtitle" value="Audience: Engineering Team | Author: patoski-patoski" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#94a3b8;" vertex="1" parent="1">
                    <mxGeometry x="400" y="55" width="500" height="20" as="geometry"/>
                </mxCell>
                <!-- USER SECTION -->
                <mxCell id="user_box" value="User (Client / Signer)&#xa;&#xa;• Wallet: Keypair Signer&#xa;• Payer for Tx &amp; Rent&#xa;• Initiates all instructions" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#38bdf8;strokeWidth=2;fontColor=#f8fafc;fontSize=13;align=center;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
                    <mxGeometry x="40" y="200" width="180" height="220" as="geometry"/>
                </mxCell>
                <!-- VAULT PROGRAM CONTAINER -->
                <mxCell id="vault_program_container" value="Anchor Vault Program (pre_req_vault)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#a855f7;strokeWidth=2;fontColor=#c084fc;fontSize=15;fontStyle=1;startSize=35;rounded=1;arcSize=4;" vertex="1" parent="1">
                    <mxGeometry x="270" y="110" width="670" height="780" as="geometry"/>
                </mxCell>
                <!-- INSTRUCTIONS SECTION INSIDE PROGRAM -->
                <mxCell id="ix_group_header" value="Program Instructions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#e2e8f0;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="20" y="45" width="200" height="25" as="geometry"/>
                </mxCell>
                <!-- 1. Initialize Instruction -->
                <mxCell id="ix_init" value="1. initialize()&#xa;&#xa;• Derives VaultState &amp; Vault PDAs&#xa;• Saves state_bump &amp; vault_bump" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#e0e7ff;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="20" y="80" width="260" height="90" as="geometry"/>
                </mxCell>
                <!-- 2. Deposit Instruction -->
                <mxCell id="ix_deposit" value="2. deposit(amount: u64)&#xa;&#xa;• CPI to System Program&#xa;• Transfers SOL: User → Vault PDA" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#dbeafe;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="20" y="200" width="260" height="90" as="geometry"/>
                </mxCell>
                <!-- 3. Withdraw Instruction -->
                <mxCell id="ix_withdraw" value="3. withdraw(amount: u64)&#xa;&#xa;• Signs with Vault PDA seeds&#xa;• Transfers SOL: Vault PDA → User&#xa;• CPI: Calls Registration Program" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#10b981;strokeWidth=2;fontColor=#d1fae5;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="20" y="320" width="260" height="120" as="geometry"/>
                </mxCell>
                <!-- 4. Close Instruction -->
                <mxCell id="ix_close" value="4. close()&#xa;&#xa;• Withdraws remaining SOL to User&#xa;• Closes VaultState &amp; Vault accounts&#xa;• Reclaims rent back to User" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1b4b;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#fee2e2;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="20" y="470" width="260" height="110" as="geometry"/>
                </mxCell>
                <!-- STATE & PDAS SECTION INSIDE PROGRAM -->
                <mxCell id="pda_group_header" value="Program State &amp; Vault PDAs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#e2e8f0;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="360" y="45" width="240" height="25" as="geometry"/>
                </mxCell>
                <!-- VaultState PDA -->
                <mxCell id="pda_vault_state" value="VaultState (PDA Account)&#xa;&#xa;Seeds: [b&quot;state&quot;, user.key()]&#xa;-----------------------------------&#xa;• vault_bump: u8&#xa;• state_bump: u8&#xa;• Space: 8 + INIT_SPACE (10 B)&#xa;• Rent Exempt Account" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#311042;strokeColor=#d946ef;strokeWidth=2;fontColor=#fae8ff;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="360" y="80" width="280" height="160" as="geometry"/>
                </mxCell>
                <!-- Vault PDA -->
                <mxCell id="pda_vault" value="Vault (SystemAccount PDA)&#xa;&#xa;Seeds: [b&quot;vault&quot;, vault_state.key()]&#xa;-----------------------------------&#xa;• Type: SystemAccount&#xa;• Holds: Deposited SOL (Lamports)&#xa;• Signed via: PDA signer_seeds&#xa;  [&quot;vault&quot;, vault_state.key, [vault_bump]]" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#10b981;strokeWidth=2;fontColor=#ecfdf5;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="vault_program_container">
                    <mxGeometry x="360" y="290" width="280" height="180" as="geometry"/>
                </mxCell>
                <!-- SYSTEM PROGRAM -->
                <mxCell id="system_program" value="Solana System Program&#xa;(11111111111111111111111111111111)&#xa;&#xa;• Handles SOL Lamport Transfers&#xa;• Account Creation &amp; Allocation" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#64748b;strokeWidth=1.5;fontColor=#f1f5f9;fontSize=12;align=center;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
                    <mxGeometry x="40" y="580" width="180" height="130" as="geometry"/>
                </mxCell>
                <!-- EXTERNAL REGISTRATION PROGRAM CONTAINER -->
                <mxCell id="reg_program_container" value="External Registration Program (Q3 PreReqs)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#f59e0b;strokeWidth=2;fontColor=#fbbf24;fontSize=15;fontStyle=1;startSize=35;rounded=1;arcSize=4;" vertex="1" parent="1">
                    <mxGeometry x="990" y="110" width="370" height="780" as="geometry"/>
                </mxCell>
                <mxCell id="reg_program_id" value="Program ID:&#xa;TRBZyQHB3m68FGeVsqTK39Wm4xejadjVhP5MAZaKWDM" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#fde68a;" vertex="1" parent="reg_program_container">
                    <mxGeometry x="10" y="45" width="350" height="30" as="geometry"/>
                </mxCell>
                <!-- CPI Target Instruction -->
                <mxCell id="reg_ix_init" value="CPI Target: initialize(github: String)&#xa;&#xa;• Called by: Vault withdraw()&#xa;• Signer: User&#xa;• Param: &quot;patoski-patoski&quot;" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fef3c7;fontSize=12;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;" vertex="1" parent="reg_program_container">
                    <mxGeometry x="30" y="90" width="310" height="100" as="geometry"/>
                </mxCell>
                <!-- Application Account PDA -->
                <mxCell id="reg_pda_account" value="ApplicationAccount (PDA)&#xa;&#xa;Seeds: [b&quot;prereqs&quot;, user.key()]&#xa;Seeds Program: Registration Program&#xa;-----------------------------------&#xa;Fields:&#xa;• user: Pubkey (User wallet)&#xa;• bump: u8&#xa;• github: String (&quot;patoski-patoski&quot;)&#xa;• pre_req_rs: bool (true)&#xa;• pre_req_ts: bool" style="shape=rect;rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=2;fontColor=#fffbeb;fontSize=12;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="reg_program_container">
                    <mxGeometry x="30" y="240" width="310" height="230" as="geometry"/>
                </mxCell>
                <!-- EDGES / CONNECTIONS -->
                <!-- User to Instructions -->
                <mxCell id="e_user_init" value="calls" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#38bdf8;" edge="1" parent="1" source="user_box" target="ix_init">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_user_deposit" value="calls + signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#38bdf8;" edge="1" parent="1" source="user_box" target="ix_deposit">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_user_withdraw" value="calls + signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#38bdf8;" edge="1" parent="1" source="user_box" target="ix_withdraw">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_user_close" value="calls + signs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#38bdf8;strokeWidth=1.5;fontColor=#38bdf8;" edge="1" parent="1" source="user_box" target="ix_close">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Initialize to PDAs -->
                <mxCell id="e_init_vault_state" value="creates &amp; sets bumps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#a5b4fc;" edge="1" parent="1" source="ix_init" target="pda_vault_state">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Deposit: Transfers SOL -->
                <mxCell id="e_dep_sys" value="invoke transfer" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#93c5fd;" edge="1" parent="1" source="ix_deposit" target="system_program">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_sys_vault" value="SOL Deposit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#3b82f6;strokeWidth=2;fontColor=#93c5fd;" edge="1" parent="1" source="system_program" target="pda_vault">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="130" y="740"/>
                            <mxPoint x="580" y="740"/>
                            <mxPoint x="580" y="526"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <!-- Withdraw: Signer seeds to transfer SOL out -->
                <mxCell id="e_with_vault" value="PDA Signer Seeds&#xa;[b&#39;vault&#39;, state.key(), bump]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#10b981;strokeWidth=2;fontColor=#6ee7b7;" edge="1" parent="1" source="ix_withdraw" target="pda_vault">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Withdraw CPI to Registration Program -->
                <mxCell id="e_with_cpi" value="Cross-Program Invocation (CPI)&#xa;initialize(ctx, &quot;patoski-patoski&quot;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#f59e0b;strokeWidth=2.5;fontColor=#fcd34d;fontStyle=1;" edge="1" parent="1" source="ix_withdraw" target="reg_ix_init">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Registration IX to Application Account -->
                <mxCell id="e_reg_acc" value="initializes &amp; records username" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fde68a;" edge="1" parent="reg_program_container" source="reg_ix_init" target="reg_pda_account">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <!-- Close Instruction Reclaim -->
                <mxCell id="e_close_user" value="closes accounts &amp; refunds rent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#fca5a5;" edge="1" parent="1" source="ix_close" target="user_box">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="420" y="820"/>
                            <mxPoint x="130" y="820"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
            </root>
        </mxGraphModel>
